generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  LEADER
  ADMIN
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  ANALYZED
}

enum ShapeSection {
  SPIRITUAL_GIFTS
  HEART
  ABILITIES
  PERSONALITY
  EXPERIENCE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         Role         @default(USER)
  churchId     String?
  church       Church?      @relation(fields: [churchId], references: [id])
  assessments  Assessment[]
  mentorNotes  MentorNote[]  @relation("MentorNoteAuthor")
  actionPlans  ActionPlan[]  @relation("ActionPlanCreator")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([churchId])
  @@index([email])
}

model Church {
  id          String   @id @default(cuid())
  name        String
  description String?
  code        String   @unique
  members     User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
}

enum ActionPlanStatus {
  PLANNED
  IN_PROGRESS
  DONE
  DEFERRED
}

enum AiJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Assessment {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            AssessmentStatus   @default(IN_PROGRESS)
  currentSection    ShapeSection       @default(SPIRITUAL_GIFTS)
  responses         Response[]
  openEnded         OpenEndedResponse[]
  shapeProfile      ShapeProfile?
  aiInsight         AiInsight?
  aiInsightSections AiInsightSection[]
  callingProfile    CallingProfile?
  mentorNotes       MentorNote[]
  actionPlans       ActionPlan[]
  observerInvites   ExternalRaterInvite[]
  aiJobs            AiJob[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

model Question {
  id               String       @id @default(cuid())
  section          ShapeSection
  category         String
  text             String
  orderIndex       Int
  reverseKeyed     Boolean      @default(false)
  isAttentionCheck Boolean      @default(false)
  responses        Response[]

  @@unique([section, orderIndex])
  @@index([section])
}

model Response {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id])
  value        Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
}

model ShapeProfile {
  id             String     @id @default(cuid())
  assessmentId   String     @unique
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  spiritualGifts Json
  heart          Json
  abilities      Json
  personality    Json
  experience     Json
  quality        Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model AiInsight {
  id                      String     @id @default(cuid())
  assessmentId            String     @unique
  assessment              Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  summary                 String
  strengths               Json
  ministryRecommendations Json
  growthSuggestions       Json
  reflectionQuestions     Json
  rawResponse             String
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
}

model AiInsightSection {
  id           String       @id @default(cuid())
  assessmentId String
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  section      ShapeSection
  summary      String
  strengths    Json
  rawResponse  String       @default("")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([assessmentId, section])
  @@index([assessmentId])
}

model CallingProfile {
  id                  String     @id @default(cuid())
  assessmentId        String     @unique
  assessment          Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  designSummary       String
  callingClusters     Json
  environmentalFit    Json
  lifePatternInsight  String
  reflectionQuestions Json
  developmentPath     Json
  rawResponse         String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model OpenEndedResponse {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  promptKey    String
  text         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, promptKey])
  @@index([assessmentId])
}

model MentorNote {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation("MentorNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assessmentId])
}

model ActionPlan {
  id           String           @id @default(cuid())
  assessmentId String
  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User             @relation("ActionPlanCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title        String
  description  String           @default("")
  dueDate      DateTime?
  status       ActionPlanStatus @default(PLANNED)
  source       String           @default("manual")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([assessmentId])
}

model ExternalRaterInvite {
  id            String           @id @default(cuid())
  assessmentId  String
  assessment    Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  token         String           @unique
  raterName     String
  raterRelation String
  expiresAt     DateTime
  submittedAt   DateTime?
  createdAt     DateTime         @default(now())
  rating        ExternalRating?

  @@index([assessmentId])
}

model AiJob {
  id           String      @id @default(cuid())
  assessmentId String
  assessment   Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  type         String      @default("FULL_ANALYSIS")
  status       AiJobStatus @default(PENDING)
  phase        String?
  error        String?
  retryCount   Int         @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([assessmentId, status])
  @@index([status, updatedAt])
}

model ExternalRating {
  id        String              @id @default(cuid())
  inviteId  String              @unique
  invite    ExternalRaterInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  gifts     Json
  heart     Json
  abilities Json
  note      String?
  createdAt DateTime            @default(now())
}
